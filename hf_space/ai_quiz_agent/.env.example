# Copy this file to .env and fill in your real key. Never commit .env to git.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=huggingface
HF_MODEL=Qwen/Qwen2.5-3B-Instruct
# HF_ADAPTER=artifacts/quiz-lora-smoke
# Set a private token for the single-user development API:
# QUIZ_API_TOKEN=replace-with-your-own-random-token
MAX_CONTENT_CHARS=12000
CHUNK_SIZE_CHARS=6000
CHUNK_OVERLAP_CHARS=300
MAX_GENERATION_RETRIES=3
MAX_ANALYSIS_RETRIES=3
MIN_CONTENT_CHARS=200
